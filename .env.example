# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Safe in the browser: it can read the counter table
# and nothing else — RLS grants it SELECT on content_stats only, with no write
# policy anywhere. Used purely to subscribe to live view/like updates.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only: never prefix with NEXT_PUBLIC_ and never
# expose it to the browser. It bypasses RLS, which is exactly why the
# engagement tables have RLS on with zero policies.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Google Search Console → HTML tag verification: paste only the
# `content` value, not the whole <meta> tag. Leave blank if you verified the
# domain by DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Salt for the pseudonymous per-visitor hash. Generate with:
#   openssl rand -base64 32
# Rotating it resets everyone's 24h view window and 5-like allowance, so treat
# it as permanent once deployed.
VISITOR_SALT=
